import Section from '@/components/ui/Section';
import SectionHeader from '@/components/ui/SectionHeader';
import Icon from '@/components/ui/Icon';
import type { Page{{CLASS_NAME}} } from '@/types/content';

export default function FeaturesSection({ content }: { content: Page{{CLASS_NAME}} }) {
    if (!content.features || content.features.length === 0) {
        return null;
    }

    return (
        <Section className="py-20 bg-surface-container-low border-t border-outline/10">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                {content.features_title && (
                    <SectionHeader
                        title={content.features_title}
                        description={content.features_description ?? undefined}
                        className="mb-12 text-center"
                    />
                )}

                <div className="grid grid-cols-1 md:grid-cols-12 gap-6">
                    {content.features.map((feature, idx) => {
                        const colSpan = feature.col_span ? `md:col-span-${feature.col_span}` : 'md:col-span-4';
                        return (
                            <div
                                key={idx}
                                className={`${colSpan} col-span-12 p-8 rounded-xl bg-surface border border-outline/15 hover:border-primary/40 transition-all duration-300 flex flex-col justify-between`}
                            >
                                <div>
                                    {feature.icon && (
                                        <div className="w-12 h-12 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-6">
                                            <Icon name={feature.icon} className="text-2xl" />
                                        </div>
                                    )}
                                    {feature.badge && (
                                        <span className="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/20 text-primary mb-3">
                                            {feature.badge}
                                        </span>
                                    )}
                                    <h3 className="text-xl font-bold text-text-white mb-2">
                                        {feature.title}
                                    </h3>
                                    <p className="text-on-surface-variant text-sm leading-relaxed">
                                        {feature.description}
                                    </p>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
        </Section>
    );
}
